# ============================================================================
# CANDIDATE A: lldacing/ComfyUI_PuLID_Flux_ll (maintained fork)
# Base: runpod/worker-comfyui:5.8.6-flux1-dev-fp8
# All git clones pinned; HF downloads revision-pinned. Alara LoRA lives on
# RunPod Network Volume 'ugcinf-lora' (cec0y73w93) → /runpod-volume.
#
# All uv pip commands are pinned to /opt/venv/bin/python. The base image's
# runtime venv is /opt/venv; comfy-cli's default workspace venv is
# /comfyui/.venv. Without --python, custom-node deps land in the wrong venv
# and ComfyUI boots without them.
# ============================================================================

FROM runpod/worker-comfyui:5.8.6-flux1-dev-fp8

ARG PULID_NODE_SHA=7c7362b806c2c0f4bde8742ada9e7cb05b44d249
ARG IMPACT_PACK_SHA=429d0159ad429e64d2b3916e6e7be9c22d025c3c
ARG IMPACT_SUBPACK_SHA=50c7b71a6a224734cc9b21963c6d1926816a97f1
ARG HF_PULID_REV=492b1451255dc9d9bc3c857259690b5f8b998d4a
ARG HF_EVACLIP_REV=11afd202f2ae80869d6cef18b1ec775e79bd8d12
ARG HF_ADETAILER_REV=53cc19de382014514d9d4038601d261a7faa9b7b
ARG INSIGHTFACE_TAG=v0.7

ARG SIZE_PULID=1142099520
ARG SIZE_EVACLIP=856461210
ARG SIZE_YOLO_BBOX=52026019

ENV VENV_PYTHON=/opt/venv/bin/python

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# System deps — python3.12-dev added for insightface sdist Cython (Python.h)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libgl1 libglib2.0-0 wget unzip ca-certificates \
    python3.12-dev patch && \
    rm -rf /var/lib/apt/lists/*

# Python deps — pinned. All installs target /opt/venv explicitly.
# NOTE: facenet-pytorch NOT installed. Its 2.6.0 (Mar 2024) release pins
# torch<2.3 / pillow<10.3 / numpy<2 — incompatible with the base image's
# torch 2.12 / pillow 12 / numpy 2. Instead we patch lldacing's pulidflux.py
# to make the facenet import optional and skip registering
# PulidFluxFaceNetLoader in NODE_CLASS_MAPPINGS. PulidFluxInsightFaceLoader
# (which our workflows use) is unaffected.
RUN uv pip install --python ${VENV_PYTHON} \
    insightface==0.7.3 \
    onnxruntime-gpu==1.19.2 \
    facexlib==0.3.0 \
    ftfy==6.2.3 \
    einops==0.8.0 \
    timm==1.0.11 \
    ultralytics==8.3.162 \
    dill==0.4.1 \
    piexif==1.1.3

# PuLID FLUX node (lldacing pinned) + apply facenet-optional patch
COPY patches/lldacing-facenet-optional.patch /tmp/lldacing-facenet-optional.patch
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/lldacing/ComfyUI_PuLID_Flux_ll.git && \
    cd ComfyUI_PuLID_Flux_ll && \
    git checkout ${PULID_NODE_SHA} && \
    patch -p1 < /tmp/lldacing-facenet-optional.patch && \
    if [ -f requirements.txt ]; then \
      grep -viE '^(torch|torchvision|torchaudio|xformers|facenet-pytorch|onnxruntime|# facenet-pytorch)([<>=~! ;]|$)' requirements.txt > /tmp/req.txt; \
      uv pip install --python ${VENV_PYTHON} -r /tmp/req.txt; \
    fi

# Impact Pack + Subpack (pinned commits) — FaceDetailer node source
# sam2 git+ dep filtered (bbox-only FaceDetailer per Codex plan; sam2 is
# large and needs its own model checkpoint we do not use)
RUN cd /comfyui/custom_nodes && \
    git clone https://github.com/ltdrdata/ComfyUI-Impact-Pack.git && \
    cd ComfyUI-Impact-Pack && git checkout ${IMPACT_PACK_SHA} && \
    if [ -f requirements.txt ]; then \
      grep -viE '^(torch|torchvision|torchaudio|xformers|git\+)' requirements.txt > /tmp/ip.txt; \
      uv pip install --python ${VENV_PYTHON} -r /tmp/ip.txt; \
    fi && \
    cd /comfyui/custom_nodes && \
    git clone https://github.com/ltdrdata/ComfyUI-Impact-Subpack.git && \
    cd ComfyUI-Impact-Subpack && git checkout ${IMPACT_SUBPACK_SHA} && \
    if [ -f requirements.txt ]; then \
      grep -viE '^(torch|torchvision|torchaudio|xformers)([<>=~! ]|$)' requirements.txt > /tmp/is.txt; \
      uv pip install --python ${VENV_PYTHON} -r /tmp/is.txt; \
    fi

# Dependency sanity check — on /opt/venv only
RUN uv pip check --python ${VENV_PYTHON}

# PuLID FLUX v0.9.1 model (~1.1 GB) — HF revision-pinned
RUN mkdir -p /comfyui/models/pulid && \
    wget -q --tries=3 -O /comfyui/models/pulid/pulid_flux_v0.9.1.safetensors \
      "https://huggingface.co/guozinan/PuLID/resolve/${HF_PULID_REV}/pulid_flux_v0.9.1.safetensors" && \
    ACTUAL_SIZE=$(stat -c%s /comfyui/models/pulid/pulid_flux_v0.9.1.safetensors) && \
    if [ "$ACTUAL_SIZE" != "$SIZE_PULID" ]; then \
      echo "FAIL: pulid size mismatch expected=$SIZE_PULID got=$ACTUAL_SIZE"; exit 1; \
    fi

# EVA02-CLIP-L-14-336 (~857 MB) — HF revision-pinned
RUN mkdir -p /comfyui/models/clip && \
    wget -q --tries=3 -O /comfyui/models/clip/EVA02_CLIP_L_336_psz14_s6B.pt \
      "https://huggingface.co/QuanSun/EVA-CLIP/resolve/${HF_EVACLIP_REV}/EVA02_CLIP_L_336_psz14_s6B.pt" && \
    ACTUAL_SIZE=$(stat -c%s /comfyui/models/clip/EVA02_CLIP_L_336_psz14_s6B.pt) && \
    if [ "$ACTUAL_SIZE" != "$SIZE_EVACLIP" ]; then \
      echo "FAIL: eva-clip size mismatch expected=$SIZE_EVACLIP got=$ACTUAL_SIZE"; exit 1; \
    fi

# AntelopeV2 face-detection ONNX pack (~325 MB) — GitHub release-tag pinned
RUN mkdir -p /comfyui/models/insightface/models && \
    cd /comfyui/models/insightface/models && \
    wget -q --tries=3 \
      "https://github.com/deepinsight/insightface/releases/download/${INSIGHTFACE_TAG}/antelopev2.zip" && \
    unzip -q antelopev2.zip && rm antelopev2.zip

# YOLO face detector (bbox only — segm not needed per Codex feedback)
RUN mkdir -p /comfyui/models/ultralytics/bbox && \
    wget -q --tries=3 -O /comfyui/models/ultralytics/bbox/face_yolov8m.pt \
      "https://huggingface.co/Bingsu/adetailer/resolve/${HF_ADETAILER_REV}/face_yolov8m.pt" && \
    ACTUAL_SIZE=$(stat -c%s /comfyui/models/ultralytics/bbox/face_yolov8m.pt) && \
    if [ "$ACTUAL_SIZE" != "$SIZE_YOLO_BBOX" ]; then \
      echo "FAIL: yolo bbox size mismatch expected=$SIZE_YOLO_BBOX got=$ACTUAL_SIZE"; exit 1; \
    fi

ENV COMFY_MANAGER_MODE=offline

# Load insightface antelope pack — FAIL the build if it can't initialize
RUN ${VENV_PYTHON} -c "import insightface; app=insightface.app.FaceAnalysis(name='antelopev2', root='/comfyui/models/insightface', providers=['CPUExecutionProvider']); app.prepare(ctx_id=0, det_size=(640,640))"

# Build-time smoke test — bake and EXECUTE
# smoke_test.sh runs ComfyUI --quick-test-for-ci, captures full log,
# and greps for IMPORT FAILED / missing PuLID InsightFace loader.
COPY bench/smoke_test.sh /usr/local/bin/smoke-test.sh
RUN chmod +x /usr/local/bin/smoke-test.sh && /usr/local/bin/smoke-test.sh

LABEL org.opencontainers.image.title="ugc-pulid-candidate-a" \
      org.opencontainers.image.description="PuLID FLUX (lldacing patched) + Impact Pack FaceDetailer + Alara LoRA (via network volume)" \
      org.opencontainers.image.source="https://github.com/doganay51seker-ai/worker-comfyui"
